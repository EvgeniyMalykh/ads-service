# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL
POSTGRES_DB=ads
POSTGRES_USER=ads
POSTGRES_PASSWORD=ads
# В Docker Compose хост — имя сервиса "db"; при локальном запуске — localhost
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Отдельная БД для тестов (создаётся и удаляется автоматически pytest-django)
POSTGRES_TEST_DB=test_ads

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
